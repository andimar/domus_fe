<!doctype html>
<html lang="{{ site.language }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{{ wordpress.wp_head|raw }}</head>
<body class="{{ body_classes|default('') }}">{{ wordpress.wp_body_open|raw }}
{% if branding is defined %}{% include 'components/header.twig' %}{% else %}<header><a href="{{ site.url }}">{{ site.name }}</a></header>{% endif %}
<main>{% block content %}{% endblock %}</main>
{% if footer is defined %}{% include 'components/footer.twig' %}{% endif %}
{{ wordpress.wp_footer|raw }}</body></html>
