<section class="section opening-section" id="orari"><div class="container opening-grid"><div class="opening-intro"><h2>{{ settings.hours_title }}</h2><p>{{ settings.hours_intro }}</p><a class="text-button" href="https://www.refonline.it/" target="_blank" rel="noopener">Accedi ai referti online ↗</a>{% include 'website/optional-photo.twig' with {section:'hours'} %}</div><div class="hours-card"><h3><svg class="icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg> Gli orari del laboratorio</h3><div class="hours-blocks"><div class="hours-block"><h4>Prelievi</h4><dl><div><dt>Lunedì–venerdì</dt><dd>{{ hours.collection_weekdays_open }} – {{ hours.collection_weekdays_close }}</dd></div><div><dt>Sabato</dt><dd>{% if hours.saturday_closed %}Chiuso{% else %}{{ hours.collection_saturday_open }} – {{ hours.collection_saturday_close }}{% endif %}</dd></div></dl></div><div class="hours-block"><h4>Ritiro referti <small>dal lunedì al venerdì</small></h4><dl><div><dt>Mattina</dt><dd>{{ hours.results_morning_open }} – {{ hours.results_morning_close }}</dd></div><div><dt>Pomeriggio</dt><dd>{{ hours.results_afternoon_open }} – {{ hours.results_afternoon_close }}</dd></div></dl></div></div></div></div>{% if hours.hours_note %}<p class="hours-extra">{{ hours.hours_note }}</p>{% endif %}{% for alert in hours_notices %}<aside class="hours-alert" role="note"><p class="eyebrow">{{ alert.date_label }}</p><h3><a href="{{ alert.url }}">{{ alert.title }}</a></h3><div>{{ alert.content_html|raw }}</div></aside>{% endfor %}</section>