<section class="section other-services-section" id="altri-servizi"><div class="container"><div class="section-heading"><div><h2>{{ settings.services_title }}</h2></div><p>{{ settings.services_intro }}</p></div>{% include 'website/optional-photo.twig' with {section:'services'} %}<div class="service-list">
{% for service in services %}<article class="service-card">{% if service.image.url %}<a href="{{ service.url }}"><img src="{{ service.image.url }}" alt="{{ service.image.alt }}" loading="lazy" width="600" height="400"></a>{% endif %}<div><h3><a href="{{ service.url }}">{{ service.title }}</a></h3><p>{{ service.summary }}</p>{% if service.booking %}<p class="service-booking">Su prenotazione · <a href="{{ settings.phone_href }}">{{ settings.phone }}</a></p>{% endif %}{% if service.price is not null %}<p class="package-price">€ {{ service.price }}</p>{% endif %}<a class="text-button" href="{{ service.url }}">Informazioni sul servizio →</a></div></article>{% endfor %}
</div></div></section>
