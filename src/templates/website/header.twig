<div class="utility-bar" data-bar-style="{{ top_bar_style }}"><div class="container utility-inner"><span><svg class="icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 10c0 6-7 11-7 11S5 16 5 10a7 7 0 0 1 14 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg> Il tuo laboratorio a Roma, Centocelle</span><div><a href="{{ settings.phone_href }}">{{ settings.phone }}</a><a href="{{ settings.email_href }}">{{ settings.email }}</a></div></div></div><header class="site-header"><div class="container header-inner">
<a class="brand" href="{{ site.url }}" aria-label="Domus Medica, homepage"><img src="{{ assets.logo }}" width="482" height="95" alt="{{ settings.site_name }}"><span>LABORATORIO DI ANALISI CLINICHE</span></a>
<button class="menu-toggle icon-button" aria-controls="main-navigation" aria-expanded="false" aria-label="Apri il menu"><svg class="icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button>
<nav id="main-navigation" aria-label="Navigazione principale">{% for link in navigation %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}<a class="mobile-reports-link" href="{{ settings.reports_url }}" target="_blank" rel="noopener">Referti online <span aria-hidden="true">↗</span><span class="sr-only"> (sito esterno, nuova scheda)</span></a></nav>
<div class="header-actions"><a class="notification-trigger icon-button" href="{{ notices_url }}" data-notice-dialog="notifications" aria-haspopup="dialog" aria-label="Apri avvisi al pubblico: {{ active_count }} attivi"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-2 7-2 9h16c0-2-2-2-2-9M10 21h4"/></svg>{% if active_count %}<span class="notification-count">{{ active_count }}</span>{% endif %}</a><a class="button button-secondary" href="{{ settings.reports_url }}" target="_blank" rel="noopener">Referti online ↗</a></div>
</div></header>
