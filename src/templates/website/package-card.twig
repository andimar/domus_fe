<article class="package-card" data-package-id="{{ item.id }}" data-package="" data-group="{{ item.group }}"><div class="package-visual"><a class="package-media" href="{{ item.url }}" aria-label="Scopri {{ item.title }}"><img src="{{ item.image.url }}" alt="{{ item.image.alt }}" width="750" height="419" loading="lazy" decoding="async"></a><h3><a href="{{ item.url }}">{{ item.title }}</a></h3></div><div class="package-card-top"><span class="eyebrow">{{ item.group_label }}</span><span class="package-symbol"><svg class="icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 5a5 5 0 0 0-8 1 5 5 0 0 0-8-1c-5 5 2 11 8 15 6-4 13-10 8-15Z"></path><path d="M5 12h4l2-4 3 8 2-4h3"></path></svg></span></div><p class="package-summary">{{ item.summary }}</p><p class="package-detail">{{ item.tests_preview }}</p><div class="package-card-bottom"><span class="package-price">{% if item.price is not null %}<span class="currency">€</span>{{ item.price_whole }}<span class="price-decimal">,{{ item.price_decimal }}</span>{% else %}<span class="price-on-request">Chiedi informazioni</span>{% endif %}</span><a class="round-arrow package-card-link" href="{{ item.url }}" aria-label="Scopri {{ item.title }}"><span class="package-link-label">Scopri</span><svg class="icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"></path></svg></a></div></article>
