<section class="section visit-section" id="visita"><div class="container"><div class="section-heading"><div><h2>{{ settings.visit_title }}</h2></div><a class="text-button" href="{{ site.url }}#domande">Hai una domanda? <svg class="icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"></path></svg></a></div><div class="visit-content"><figure class="visit-photo"><img src="{{ images.visit[0].url }}" alt="{{ images.visit[0].alt }}" width="1536" height="1024" loading="lazy" style="object-position: 50% 45%;" data-domus-photo="visit"></figure><ol class="visit-steps"><li><h3>{{ settings.step1_title }}</h3><p>{{ settings.step1_text }}</p></li><li><h3>{{ settings.step2_title }}</h3><p>{{ settings.step2_text }}</p></li><li><h3>{{ settings.step3_title }}</h3><p>{{ settings.step3_text }}</p></li></ol></div></div></section>