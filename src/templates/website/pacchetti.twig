<section class="section packages-section" id="pacchetti"><div class="container"><div class="section-heading"><div><h2>{{ settings.packages_title }}</h2></div><p>{{ settings.packages_intro }}</p></div>
{% include 'website/optional-photo.twig' with {section:'packages'} %}<div class="package-toolbar"><div class="filter-list" role="group" aria-label="Filtra i pacchetti"><button class="filter-button is-active" data-filter="all" aria-pressed="true">Tutti i pacchetti</button>{% for category in package_categories %}<button class="filter-button" data-filter="{{ category.slug }}" aria-pressed="false">{{ category.name }}</button>{% endfor %}</div><span class="package-counter" aria-live="polite" data-package-counter=""><span data-package-counter="">{{ packages|length }} pacchetti</span></span></div>
<div class="package-grid">{% for item in packages %}{% include 'website/package-card.twig' %}{% else %}<p>I pacchetti saranno pubblicati a breve.</p>{% endfor %}</div><div class="packages-footer"><p>{{ settings.packages_note }}</p><button type="button" class="button button-primary packages-more" data-show-packages="">Mostra gli altri {{ packages|length - 3 }} pacchetti</button></div>
</div></section>