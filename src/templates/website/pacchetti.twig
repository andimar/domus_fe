<section class="section packages-section" id="pacchetti"><div class="container"><div class="section-heading"><div><h2>{{ settings.packages_title }}</h2></div><p>{{ settings.packages_intro }}</p></div>
{% include 'website/optional-photo.twig' with {section:'packages'} %}<div class="package-toolbar"><div class="filter-list" role="group" aria-label="Filtra i pacchetti"><button class="filter-button is-active" data-filter="all" aria-pressed="true">Tutti i pacchetti</button><button class="filter-button" data-filter="checkup" aria-pressed="false">Check-up</button><button class="filter-button" data-filter="donna" aria-pressed="false">Salute donna</button><button class="filter-button" data-filter="specifici" aria-pressed="false">Esami specifici</button></div><span class="package-counter" aria-live="polite" data-package-counter=""><span data-package-counter="">{{ packages|length }} pacchetti</span></span></div>
<div class="package-grid">{% for item in packages %}<article class="package-card" data-package-id="{{ item.id }}" data-package="" data-group="{{ item.group }}"><div class="package-visual"><a class="package-media" href="{{ item.url }}" aria-label="Scopri {{ item.title }}"><img src="{{ item.image.url }}" alt="{{ item.image.alt }}" width="750" height="419" loading="lazy" decoding="async"></a><h3><a href="{{ item.url }}">{{ item.title }}</a></h3></div><div class="package-card-top"><span class="eyebrow">{{ item.group_label }}</span><span class="package-symbol"><svg class="icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 5a5 5 0 0 0-8 1 5 5 0 0 0-8-1c-5 5 2 11 8 15 6-4 13-10 8-15Z"></path><path d="M5 12h4l2-4 3 8 2-4h3"></path></svg></span></div><p>{{ item.summary }}</p><p class="package-detail">{{ item.tests_preview }}</p><div class="package-card-bottom"><span class="package-price">{% if item.price is not null %}<span class="currency">€</span>{{ item.price_whole }}<span class="price-decimal">,{{ item.price_decimal }}</span>{% else %}<span class="price-on-request">Chiedi informazioni</span>{% endif %}</span><a class="round-arrow" href="{{ item.url }}" aria-label="Scopri {{ item.title }}"><svg class="icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"></path></svg></a></div></article>{% else %}<p>I pacchetti saranno pubblicati a breve.</p>{% endfor %}</div><div class="packages-footer"><p>{{ settings.packages_note }}</p><button type="button" class="text-button" data-show-packages="">Mostra tutti i pacchetti →</button></div>
</div></section>