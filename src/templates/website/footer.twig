<footer class="site-footer"><div class="container footer-top">
<div class="footer-brand"><a href="{{ site.url }}"><img src="{{ assets.logo_light }}" width="482" height="95" alt="Domus Medica"></a><p>{{ settings.footer_text }}</p></div>
<div><h2>Il laboratorio</h2><a href="{{ site.url }}#pacchetti">Pacchetti e analisi</a><a class="footer-link" href="{{ notices_url }}">Avvisi al pubblico</a></div>
<div><h2>Per la tua visita</h2><a href="{{ site.url }}#orari">Orari </a><a href="{{ site.url }}#contatti">Contatti</a><a href="{{ site.url }}#domande">Domande frequenti</a><a href="{{ settings.reports_url }}" target="_blank" rel="noopener">Referti online ↗</a></div>
<div><h2>Restiamo in contatto</h2><a href="{{ settings.phone_href }}">{{ settings.phone }}</a><a href="{{ settings.email_href }}">{{ settings.email }}</a><p>{{ settings.address ~ ' · ' ~ settings.postcode ~ ' ' ~ settings.city }}</p><a href="{{ settings.facebook }}" target="_blank" rel="noopener">Facebook ↗</a></div>
</div><div class="container footer-bottom"><span>{{ '© ' ~ year ~ ' ' ~ settings.company ~ ' · P. IVA ' ~ settings.vat }}</span><span class="image-disclosure">Le immagini illustrative del laboratorio sono generate con IA e non ritraggono gli ambienti o il personale reali.</span>{% if privacy_url %}<a href="{{ privacy_url }}">Privacy</a>{% endif %}{% if settings.footer_show_login == '1' %}<a href="{{ settings.footer_login_url }}" class="footer-login">Accedi</a>{% endif %}</div></footer>
