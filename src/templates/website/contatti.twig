<section class="section contact-section" id="contatti" data-integrated="1"><div class="container"><div class="section-heading"><div><h2>{{ settings.contact_title }}</h2></div></div><div class="contact-about"><div class="laboratory-visual"><img src="{{ images.contact[0].url }}" width="1536" height="1024" alt="{{ images.contact[0].alt }}" loading="lazy" data-domus-photo="contact" style="object-position: 50% 45%;"></div><div class="laboratory-copy"><p>{{ settings.contact_text }}</p><div class="contact-channels"><a class="contact-phone" href="{{ settings.phone_href }}"><span>Telefono</span><strong>{{ settings.phone }}</strong></a><a class="contact-email" href="{{ settings.email_href }}"><span>Email</span><strong>{{ settings.email }}</strong></a><a class="contact-social" href="{{ settings.facebook }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 21v-8h3l.5-4H14V7c0-1 .3-2 2-2h2V1.5C17.6 1.3 16.5 1 15 1c-3 0-5 2-5 5v3H7v4h3v8Z"></path></svg>Seguici su Facebook <span aria-hidden="true">↗</span></a></div></div></div><div class="contact-grid"><div class="contact-intro"><div class="route-controls" aria-label="Il tuo itinerario"><fieldset class="route-options"><legend>Il tuo itinerario</legend><p class="route-destination">{{ 'Verso ' ~ settings.address }}</p><div class="route-options-grid"><label class="route-choice"><input type="radio" name="route-mode" value="transit" checked=""><span>Mezzi pubblici</span></label><label class="route-choice"><input type="radio" name="route-mode" value="driving"><span>Auto</span></label><label class="route-choice"><input type="radio" name="route-mode" value="walking"><span>A piedi</span></label></div></fieldset><a class="button button-primary route-button" href="{{ maps_url }}" target="_blank" rel="noopener" aria-label="Apri l’itinerario in Google Maps con i mezzi pubblici">Apri Google Maps <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" aria-hidden="true"><path d="M8 5H5v14h14v-3M12 5h7v7M10 14l9-9"></path></svg></a><p class="route-note">In Google Maps scegli la partenza o usa la tua posizione.</p></div>{% if transport.visible %}<section class="transport-block" aria-labelledby="transport-heading"><h3 id="transport-heading">{{ transport.title }}</h3><table class="transport-table"><caption>{{ transport.area }}</caption><thead><tr><th scope="col">Mezzo</th><th scope="col">Linee</th></tr></thead><tbody>{% for group in transport.groups %}<tr><th scope="row">{{ group.label }}</th><td><div class="transport-line-links">{% for line in group.lines %}<a href="{{ line.href }}" target="_blank" rel="noopener">{{ line.label }}</a>{% endfor %}</div>{% if group.note %}<small>{{ group.note }}</small>{% endif %}</td></tr>{% endfor %}</tbody></table><p class="transport-note">{{ transport.note }} {% if transport.alert_url %}<a href="{{ transport.alert_url }}" target="_blank" rel="noopener">Avvisi di servizio ↗</a>{% endif %}</p></section>{% endif %}</div>
<div class="address-card"><div class="map-frame">{{ map_html|raw }}</div><div class="address-content"><div><h3>{{ settings.address }}</h3><p>{{ settings.postcode }} {{ settings.city }}</p><p class="transport-note">Metro C · {{ transport.groups[0].note|default('Gardenie / Mirti') }}</p></div><a class="round-arrow" href="https://www.openstreetmap.org/directions?to=41.8863007%2C12.5662862" target="_blank" rel="noopener" aria-label="Apri le indicazioni stradali"><svg class="icon " viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 5H5v14h14v-3M12 5h7v7M10 14l9-9"></path></svg></a></div></div></div></div></section>