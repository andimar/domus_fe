{% if home.hours.visible %}<section class="domus-hours domus-container" id="orari"><div class="domus-section-title"><h2>{{ home.hours.title }}</h2><hr></div><div class="domus-hours-grid"><div><h3>{{ home.hours.collection_title }}</h3><table><thead><tr><th></th><th>Apertura</th><th>Chiusura</th></tr></thead><tbody>{% for row in home.hours.collection %}<tr><th>{{ row.label }}</th><td>{{ row.open }}</td><td>{{ row.close }}</td></tr>{% endfor %}</tbody></table></div><div><h3>{{ home.hours.results_title }}</h3>{{ home.hours.results_description_html|raw }}<table><thead><tr><th></th><th>Apertura</th><th>Chiusura</th></tr></thead><tbody>{% for row in home.hours.results %}<tr><th>{{ row.label }}</th><td>{{ row.open }}</td><td>{{ row.close }}</td></tr>{% endfor %}</tbody></table></div></div></section>{% endif %}