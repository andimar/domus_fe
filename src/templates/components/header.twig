<div class="domus-contact-bar"><div class="domus-container"><a class="domus-facebook" href="{{ branding.facebook_url }}">Seguici su Facebook</a><a href="tel:{{ branding.phone|replace({' ': '', '(': '', ')': ''}) }}">{{ branding.phone }}</a><a href="mailto:{{ branding.email }}">{{ branding.email }}</a></div></div>
<header class="domus-header"><div class="domus-container"><a href="{{ site.url }}">{% if branding.logo_url %}<img class="domus-logo" src="{{ branding.logo_url }}" alt="{{ branding.title }}">{% else %}{{ branding.title }}{% endif %}</a>
<button type="button" data-menu-toggle aria-label="Menu" aria-expanded="false" aria-controls="domus-navigation"><svg class="domus-menu-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button><nav id="domus-navigation" aria-label="Menu principale"><ul>{% for item in navigation %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}<li><a href="https://www.refonline.it/">Referti online</a></li></ul></nav></div></header>
